# Normalize line endings for text files, auto-detected
* text=auto

# Explicit text formats (scripts, configs, docs)
*.py    text diff=python
*.md    text
*.txt   text
*.json  text
*.toml  text
*.yml   text
*.yaml  text
*.osl   text
*.glsl  text
# ---------------------------------------------------------------------------
# Git LFS — binary / large assets
# To enable file locking (needs a server that supports it), append `lockable`
# to the lines below, e.g.: *.blend filter=lfs diff=lfs merge=lfs -text lockable
# Blender
*.blend    filter=lfs diff=lfs merge=lfs -text
*.blend1   filter=lfs diff=lfs merge=lfs -text
*.blend2   filter=lfs diff=lfs merge=lfs -text
*.blend[0-9][0-9] filter=lfs diff=lfs merge=lfs -text
